# Example configuration — Inventory and Stock Management System
# Copy to .env and fill in locally. Placeholders ONLY — never put real secrets in this file.
# These match the libpq/pgx PG* environment variables the Go backend (T-104) will read.

PGHOST=localhost
PGPORT=5432
PGDATABASE=inventory_db
PGUSER=inventory_app
PGPASSWORD=CHANGE_ME_LOCAL_ONLY
PGSSLMODE=disable
APP_PORT=8081
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
